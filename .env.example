# Set the real value in a local .env or your hosting service's secret settings.
# Never commit the real token or paste it into chat.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to test Sift.
# Leave empty for ID lookup only. Send /id privately to @SiftAgentbot,
# then add your returned ID here and restart the process.
SIFT_ALLOWED_USER_IDS=

# Enforced $0 API mode. Keep true: an enabled paid AI adapter prevents startup.
# This does not change external Codespaces/hosting allowance or billing settings.
SIFT_FREE_ONLY=true
# Preserve this directory when restarting or updating. Defaults to .sift.
SIFT_DATA_DIR=.sift

# Pump.fun candidate discovery through PumpPortal's free launch/migration feed.
# No API key or wallet. Never subscribes to paid token/account trade data.
# Connects only for approved active scans or a short /sources diagnostic.
SIFT_PUMPFUN_ENABLED=true
# Public DLMM/DAMM v2 APIs, once per minute when scanning or checking /sources.
SIFT_METEORA_ENABLED=true

# Optional API interpretation. Disabled by default; local parsing stays free.
# Enabling this uses separately billed OpenAI API usage, not ChatGPT/Codex credits.
# Set a supported model explicitly. The bot permits at most 20 requests/UTC day,
# 1,200 output tokens each, and one attempt per Telegram update. Set provider
# project spending limits too; this request cap is not a dollar budget.
SIFT_AI_ENABLED=false
OPENAI_API_KEY=
SIFT_AI_MODEL=

# Optional web workspace, served by this SAME bot process and SQLite store.
# No second poller. Point ROOT at SiftAgent/dist/app (never the whole repository).
SIFT_WEB_ENABLED=false
SIFT_WEB_ROOT=../SiftAgent/dist/app
SIFT_WEB_PORT=3000
SIFT_WEB_HOST=127.0.0.1
SIFT_WEB_ORIGIN=http://localhost:3000
# For a forwarded preview use its HTTPS origin and SIFT_WEB_HOST=0.0.0.0.
# The frontend and /api must share one origin; do not expose secrets in Vercel.
