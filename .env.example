# Set the real values in a local .env (chmod 600) or your hosting service's
# secret settings. Never commit them or paste them into chat.

# From @BotFather. Telegram bot tokens do not expire unless revoked.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to test Sift.
# Leave empty at first: send /id privately to @SiftAgentbot, add the
# returned ID here and restart. Removing an ID and restarting cuts that
# tester off at once, including alerts already queued.
SIFT_ALLOWED_USER_IDS=

# From console.anthropic.com. Needed for testers to create criteria:
# Claude turns plain-language descriptions into rules for /approve, and
# routes free text like "what works today?" to the fixed commands.
# Without it the bot runs, but testers cannot set up rules.
ANTHROPIC_API_KEY=

# Optional: Claude model (default claude-opus-5-5).
SIFT_CLAUDE_MODEL=

# Optional: directory for Sift's SQLite state (criteria, scanning switches,
# watch list, alert ledger, Telegram offset). Default: .sift/ in the
# working directory. The systemd service overrides it with /var/lib/sift-bot.
SIFT_DATA_DIR=

# Optional: seconds between scan cycles while any tester has /scan on
# (whole number, 30-3600). Default: 60.
SIFT_SCAN_INTERVAL_SECONDS=

# Optional: minutes each new token stays on the watch list and is
# re-checked as its numbers change (whole number, 0-120). Default: 30.
# 0 judges each token only once, at launch.
SIFT_WATCH_MINUTES=
