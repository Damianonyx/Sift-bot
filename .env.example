# Set the real value in a local .env or your hosting service's secret settings.
# Never commit the real token or paste it into chat.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to test Sift.
# Leave empty for ID lookup only. Send /id privately to @SiftAgentbot,
# then add your returned ID here and restart the process.
SIFT_ALLOWED_USER_IDS=

# Optional: turns on plain-language commands for approved testers.
# Claude maps free text like "what works today?" to /start, /help,
# /status or /id; Sift still sends its fixed replies. Leave empty to
# keep slash commands only. Never commit the real key.
ANTHROPIC_API_KEY=

# Optional: Claude model for plain-language commands (default claude-opus-5-5).
SIFT_CLAUDE_MODEL=
